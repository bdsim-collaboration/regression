<?xml version="1.0"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="http://cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
  <define/>
  <materials/>
  <solids>
    <box name="box" x="20" y="30" z="40" lunit="mm"/>
    <box name="world" x="200" y="200" z="200" lunit="mm"/>
  </solids>
  <structure>
    <volume name="box_lv">
      <materialref ref="G4_Cu"/>
      <solidref ref="box"/>
    </volume>
    <volume name="world_lv">
      <materialref ref="G4_Galactic"/>
      <solidref ref="world"/>
      <physvol name="box_pv">
        <volumeref ref="box_lv"/>
      </physvol>
    </volume>
  </structure>
  <setup name="Default" version="1.0">
    <world ref="world_lv"/>
  </setup>
</gdml>
